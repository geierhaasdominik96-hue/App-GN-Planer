* text=auto

# Linux-/Container-Dateien muessen auch nach einem Windows-Checkout LF behalten.
*.sh text eol=lf
Dockerfile text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-Starter bleiben fuer Doppelklick und Windows PowerShell bei CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
