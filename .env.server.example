# Diese Beispieldatei ist nicht fuer den echten Betrieb bestimmt.
# Start-App-Planner-2.cmd bzw. Start-Server-Linux.sh erzeugen .env.server
# automatisch mit sicheren Zufallswerten.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=http://192.0.2.10:3001
WEB_ORIGINS=http://192.0.2.10:3001
APP_BIND_ADDRESS=0.0.0.0
TRUST_PROXY=false
# Optional fuer feste Domain/Reverse-Proxy; wird vom Serverstarter beibehalten.
# PUBLIC_URL_OVERRIDE=https://gn-planer.schule.example
# WEB_ORIGINS_OVERRIDE=https://gn-planer.schule.example
# APP_BIND_ADDRESS_OVERRIDE=127.0.0.1
# Hinter einem vertrauenswuerdigen Reverse-Proxy zusaetzlich: TRUST_PROXY=true
# Optional: vorhandener Ordner auf einem zweiten Datentraeger oder Netzlaufwerk.
# BACKUP_MIRROR_HOST_DIRECTORY=D:\GN-Planer-Sicherungskopie
