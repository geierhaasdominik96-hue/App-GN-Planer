NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://gn_planer:local-development-only@localhost:5432/gn_planer
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Optional. Unter Windows wird sonst %LOCALAPPDATA%\GN-Planer\Sicherungen verwendet.
# BACKUP_DIRECTORY=D:\GN-Planer-Sicherungen
# Optionales zweites, von der Schule freigegebenes Sicherungsziel.
# BACKUP_MIRROR_DIRECTORY=Z:\GN-Planer-Sicherungen

# Nur einmalig für `pnpm bootstrap:teacher` setzen und danach wieder entfernen.
BOOTSTRAP_TEACHER_ID=lehrkraft
BOOTSTRAP_TEACHER_NAME=Lehrkraft
BOOTSTRAP_TEACHER_PASSWORD=replace-with-a-long-password
